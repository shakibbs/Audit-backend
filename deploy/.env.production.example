# Copy to deploy/.env.production on the server and fill in. Never commit the real file.

# --- Addresses (DNS A records must point to the server) ---
APP_DOMAIN=app.complyiv.com
ADMIN_DOMAIN=admin.complyiv.com

# --- Traefik already on the server (read with: docker inspect <traefik container>) ---
TRAEFIK_NETWORK=n8n_default
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=mytlschallenge

# --- Django ---
# Make each secret with: openssl rand -base64 48
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# "backend" is how the portal reaches Django inside Docker.
DJANGO_ALLOWED_HOSTS=admin.complyiv.com,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.complyiv.com,https://admin.complyiv.com
PORTAL_URL=https://app.complyiv.com
DEFAULT_FROM_EMAIL=CiV <no-reply@complyiv.com>

# --- Database (only the backend can reach it) ---
DB_PASSWORD=

# --- Locks client API keys. Make with: docker compose run --rm backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a safe copy outside the server: if lost, saved keys cannot be read.
CIV_SECRETS_KEYS=
