# CiV page capture worker: the backend code plus Chromium. Runs only the "capture" queue (photos of public consent
# pages), so the browser never runs inside the backend or the main worker.
FROM python:3.14-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium fonts-liberation fonts-noto-color-emoji \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /usr/local/bin/uv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv PATH="/app/.venv/bin:$PATH" CHROMIUM_PATH=/usr/bin/chromium
WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY . .
RUN useradd --create-home --uid 10001 civ && mkdir -p /app/media && chown -R civ /app
USER civ

ENTRYPOINT ["celery", "-A", "config", "worker", "--queues", "capture", "--loglevel", "info", "--concurrency", "1"]
